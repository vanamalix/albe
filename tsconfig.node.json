{
  "extends": "@vanamalix/config/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "headers.config.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
